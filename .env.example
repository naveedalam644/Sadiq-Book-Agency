# Bookstore Management System - Environment Configuration
# Copy this file to .env and fill in your actual Firebase project values from Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration -> Config

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# Business Info (Customizable placeholders)
VITE_APP_NAME="Bookstore Management System"
VITE_BUSINESS_NAME="Bookstore & Stationers"
