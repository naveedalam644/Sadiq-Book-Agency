rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // AUTHENTICATION & ACCESS CONTROLS
    // Strictly requires authenticated users from this Firebase project.
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStoreAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['uh5882000@gmail.com', 'admin@sadiqbookagency.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function isStaff() {
      return isAuthenticated();
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all access by default for unauthenticated requests
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 1. USERS COLLECTION
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read, create, update: if isSelf(userId) || isStoreAdmin();
      allow delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. SETTINGS & APP STATE
    // -------------------------------------------------------------------------
    match /settings/{settingId} {
      allow read, write: if isStaff();
    }

    // -------------------------------------------------------------------------
    // 3. AUDIT LOGS
    // -------------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isStoreAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // 4. PRODUCTS CATALOG
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow read, create, update: if isStaff();
      allow delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 5. INVENTORY HIERARCHIES & ATTRIBUTES
    // -------------------------------------------------------------------------
    match /categories/{categoryId} { allow read, write: if isStaff(); }
    match /publishers/{publisherId} { allow read, write: if isStaff(); }
    match /series/{seriesId} { allow read, write: if isStaff(); }
    match /notebookAttributes/{attributeId} { allow read, write: if isStaff(); }
    match /boards/{boardId} { allow read, write: if isStaff(); }
    match /schools/{schoolId} { allow read, write: if isStaff(); }
    match /syllabusSets/{setId} { allow read, write: if isStaff(); }
    match /roughBills/{billId} { allow read, write: if isStaff(); }

    // -------------------------------------------------------------------------
    // 6. SUPPLIERS & PURCHASES
    // -------------------------------------------------------------------------
    match /suppliers/{supplierId} { allow read, write: if isStaff(); }
    match /purchases/{purchaseId} {
      allow read, create, update: if isStaff();
      allow delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 7. STOCK BATCHES & FIFO TRACKING
    // -------------------------------------------------------------------------
    match /stockBatches/{batchId} {
      allow read, create, update: if isStaff();
      allow delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 8. STOCK MOVEMENTS (IN/OUT AUDIT)
    // -------------------------------------------------------------------------
    match /stockMovements/{movementId} {
      allow read, create: if isStaff();
      allow update, delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 9. CUSTOMERS & KHATA ACCOUNTS
    // -------------------------------------------------------------------------
    match /customers/{customerId} {
      allow read, create, update: if isStaff();
      allow delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 10. CUSTOMER DISCOUNTS
    // -------------------------------------------------------------------------
    match /customerDiscounts/{discountId} {
      allow read, write: if isStaff();
    }

    // -------------------------------------------------------------------------
    // 11. CUSTOMER LEDGER (DEBIT/CREDIT ENTRIES)
    // -------------------------------------------------------------------------
    match /customerLedger/{ledgerId} {
      allow read, create: if isStaff();
      allow update, delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 12. PAYMENTS & VOUCHERS
    // -------------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read, create: if isStaff();
      allow update, delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 13. SALES & INVOICES
    // -------------------------------------------------------------------------
    match /sales/{saleId} {
      allow read, create, update: if isStaff();
      allow delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 14. SALES RETURNS & SUMMARIES
    // -------------------------------------------------------------------------
    match /salesReturns/{returnId} {
      allow read, create: if isStaff();
      allow update, delete: if isStoreAdmin();
    }

    match /saleReturnSummaries/{invoiceNo} {
      allow read, create, update: if isStaff();
      allow delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 15. EXPENSES
    // -------------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read, write: if isStaff();
    }

    // -------------------------------------------------------------------------
    // 16. WHATSAPP AUDIT
    // -------------------------------------------------------------------------
    match /whatsappMessages/{messageId} {
      allow read, create: if isStaff();
      allow update, delete: if isStoreAdmin();
    }

    // -------------------------------------------------------------------------
    // 17. WHOLESALE CUSTOMER ONLINE KHATA PORTAL (READ-ONLY FOR WHOLESALE CLIENTS)
    // -------------------------------------------------------------------------
    match /customerPortals/{portalCode} {
      // Allows read for wholesale clients via their secret portalCode
      allow read: if true;
      allow write: if isStaff();

      match /invoices/{invoiceId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /ledger/{entryId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }
  }
}
